# Environment Configuration Template
#
# This file serves as a template for local development.
# Copy this file to `.env` and fill in your values.
#
# IMPORTANT: Never commit .env files with real values to the repository.
# CI/CD uses GitHub Secrets instead of .env files.

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
# Environment name (development, staging, production)
# Used for conditional logic and logging
# Default: development
APP_ENV=development

# =============================================================================
# LOGGING
# =============================================================================
# Enable verbose logging (true/false)
# Set to true for development, false for production
# Default: false
VERBOSE_LOGGING=false

# =============================================================================
# ERROR TRACKING (SENTRY)
# =============================================================================
# Sentry DSN for error tracking
# Get this from your Sentry project settings
# Leave empty to disable Sentry
# Default: '' (empty - Sentry disabled)
SENTRY_DSN=

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================
# GitHub Personal Access Token for in-app feedback system
# Required scopes: repo (for creating issues)
# Leave empty to disable GitHub feedback integration
# Default: '' (empty - GitHub feedback disabled)
GITHUB_TOKEN=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable result-based providers (true/false)
# Alternative to AsyncNotifier providers for better error handling
USE_RESULT_PROVIDERS=false

# Comma-separated list of enabled features
# Available features: home, wallet, dapps, profile, node
# Leave empty to enable all features
ENABLED_FEATURES=home,wallet,dapps,profile,node

# Comma-separated list of disabled features
# Takes precedence over ENABLED_FEATURES
# Leave empty to disable no features
DISABLED_FEATURES=

# =============================================================================
# NOTES FOR LOCAL DEVELOPMENT
# =============================================================================
# The .env file is OPTIONAL. The app has sensible defaults for all variables.
#
# To customize environment variables:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your custom values
# 3. Run with: flutter run --dart-define-from-file=.env
#
# To use defaults (development mode, no Sentry, no GitHub):
# 1. Simply run: flutter run
# 2. No .env file needed!
#
# Important:
# - Never commit .env files to git
# - For CI/CD, use GitHub Secrets instead (see docs/SECRETS.md)
# - All variables have safe defaults in the code
