ENV['CMAKE'] = '/opt/homebrew/bin/cmake'

# Define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    # For simulator builds
    config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
    config.build_settings['ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    
    # For device builds (Release/Archive) - THIS IS THE KEY FIX
    config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'  # Changed from YES
    config.build_settings['ARCHS[sdk=iphoneos*]'] = 'arm64'
    
    # CMake and native build settings
    config.build_settings['CMAKE'] = '/opt/homebrew/bin/cmake'
    config.build_settings['PATH'] = '/opt/homebrew/bin:$(PATH)'
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Simulator settings
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      config.build_settings['ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      
      # Device/Archive settings - CRITICAL FOR RUST DEPENDENCIES
      if config.name == 'Release'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'  # Must be NO for Archive
        config.build_settings['ARCHS'] = 'arm64'
      else
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'  # YES for Debug/Profile
      end
      
      # Deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      
      # CMake environment for native dependencies
      config.build_settings['CMAKE'] = '/opt/homebrew/bin/cmake'
      config.build_settings['PATH'] = '/opt/homebrew/bin:$(PATH)'
      
      # Rust/native compilation flags
      if target.name.include?('rust') || target.name.include?('crypto')
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = '$(inherited) COCOAPODS=1'
      end

      # FIX FOR SENTRY WARNING - Add this section
      if target.name == 'Sentry'
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        config.build_settings['SWIFT_EMIT_MODULE_INTERFACE'] = 'YES'
      end
    end
    
    flutter_additional_ios_build_settings(target)
  end
end