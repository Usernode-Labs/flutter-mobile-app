<?xml version="1.0" encoding="utf-8"?>
<!-- The ground the Usernode shell opens on, in both appearances.
     These are the SAME two values the SV web shell paints
     (frontend/src/head.html's critical <style>, `GROUND`) and
     AppearanceStorage.lightGround / darkGround: the launch window, the
     Flutter splash and the WebView all have to agree, or the seam between
     them reads as a flash. iOS keeps its copy in
     LaunchBackground.colorset. -->
<resources>
    <color name="launch_background">#f4f2e4</color>
    <!-- Adaptive-icon ground. The icon artwork's own ink, deliberately NOT
         launch_background above: that one tracks the shell, this one tracks
         the logo. -->
    <color name="ic_launcher_background">#171717</color>
</resources>