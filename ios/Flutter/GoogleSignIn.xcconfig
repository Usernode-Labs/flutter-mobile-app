// is scheme "com.googleusercontent.apps.123-abc". Keep it in step with
// AppConfig.googleIosClientId (test/core/config/google_sign_in_config_test.dart).
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.362395561249-pfci84ag0r2hr8tln0taqcq9t90mslp6
