# Fastfile for Usernode CI/CD
# Uses pubspec.yaml as the single source of truth for version and build numbers

default_platform(:ios)

require 'yaml'

FASTLANE_DIR = File.expand_path(__dir__)
PROJECT_ROOT = File.expand_path('..', FASTLANE_DIR)
PUBSPEC_PATH = File.join(PROJECT_ROOT, 'pubspec.yaml')

# Load version information from pubspec.yaml
def load_pubspec
  YAML.load_file(PUBSPEC_PATH)
end

def save_pubspec(pubspec_data)
  File.write(PUBSPEC_PATH, YAML.dump(pubspec_data))
end

def get_current_version
  pubspec = load_pubspec
  version_string = pubspec['version']

  if version_string.nil? || version_string.empty?
    UI.user_error!("No version found in pubspec.yaml")
  end

  # Split version string: "0.1.1+12"
  parts = version_string.split('+')
  semantic = parts[0]           # "0.1.1"
  build = parts[1] || "1"       # "12" or default "1"

  { semantic: semantic, build: build.to_i, full: version_string }
end

def get_version_string(env_type = nil, version_info = get_current_version)
  env_type ||= ENV['BUILD_ENV'] || 'PROD'
  semantic = version_info[:semantic]
  build = version_info[:build]

  if env_type == 'PROD'
    semantic
  else
    # NONPROD builds get internal suffix
    "#{semantic}.#{build}-internal"
  end
end

def increment_pubspec_build_number(env_type = nil)
  # Note: Environment parameter accepted but ignored
  # All environments now share the same build number
  version_info = get_current_version
  new_build = version_info[:build] + 1
  new_version = "#{version_info[:semantic]}+#{new_build}"

  pubspec = load_pubspec
  pubspec['version'] = new_version
  save_pubspec(pubspec)

  UI.success("Incremented build number: #{version_info[:build]} -> #{new_build}")
  UI.success("New version: #{new_version}")

  new_build
end

def next_build_info(env_type = nil)
  env_type ||= ENV['BUILD_ENV'] || 'PROD'
  unless ENV['CI'] == 'true'
    increment_pubspec_build_number(env_type)
  end

  version_info = get_current_version
  build_number = version_info[:build]
  version_string = get_version_string(env_type, version_info)

  [build_number, version_string]
end

def commit_version_bump(paths, message)
  if ENV['CI'] == 'true'
    UI.important("CI detected — skipping git commit for '#{message}'.")
  else
    git_commit(
      path: paths,
      message: message
    )
  end
end

# iOS Platform
platform :ios do
  desc "Build and upload iOS app to TestFlight"
  lane :release do |options|
    env_type = ENV['BUILD_ENV'] || 'PROD'
    scheme = options[:scheme] || 'Runner'
    configuration = options[:configuration] || 'Release'
    
    # Environment-based provisioning profile selection
    if env_type == 'PROD'
      default_profile = "mobile-apps"
    else
      default_profile = "Usernode Internal"
    end
    provisioning_profile = ENV['PROVISIONING_PROFILE_NAME'] || default_profile
    team_id = ENV['APPLE_TEAM_ID'] || '785Y2C9VG2'

    build_number, version_string = next_build_info(env_type)

    # Update version in Xcode
    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/Runner.xcodeproj"
    )

    increment_version_number(
      version_number: version_string,
      xcodeproj: "ios/Runner.xcodeproj"
    )

    # CI must not rely on Xcode project signing settings. We keep the project
    # configured for local device development installs, and force distribution
    # signing here for archive/export.
    signing_xcargs = [
      "DEVELOPMENT_TEAM=#{team_id}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=\"iPhone Distribution\"",
      "PROVISIONING_PROFILE_SPECIFIER=\"#{provisioning_profile}\"",
    ].join(" ")

    # Build the app
    build_app(
      scheme: scheme,
      configuration: configuration,
      workspace: "ios/Runner.xcworkspace",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "org.usernode.app" => provisioning_profile
        }
      },
      xcargs: signing_xcargs,
      output_directory: "build/ios",
      output_name: "Usernode-#{env_type}-#{version_string}.ipa"
    )

    # Upload to TestFlight
    # Use API key from environment variables if available
    api_key_config = if ENV['APP_STORE_CONNECT_API_KEY_ID'] && ENV['APP_STORE_CONNECT_ISSUER_ID'] && ENV['APP_STORE_CONNECT_API_KEY']
      app_store_connect_api_key(
        key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
        issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
        key_content: ENV['APP_STORE_CONNECT_API_KEY'],
        is_key_content_base64: false
      )
    else
      nil
    end

    upload_params = {
      skip_waiting_for_build_processing: true,
      app_identifier: "org.usernode.app",
      ipa: "build/ios/Usernode-#{env_type}-#{version_string}.ipa"
    }

    # Add api_key only if it's available
    upload_params[:api_key] = api_key_config if api_key_config

    upload_to_testflight(upload_params)

    # Commit version bump
    commit_version_bump(
      ["pubspec.yaml"],
      "Bump iOS #{env_type} build to #{build_number}"
    )
  end

  desc "Build iOS app for internal testing"
  lane :internal do
    ENV['BUILD_ENV'] = 'NONPROD'
    release
  end

  desc "Build iOS app for production"
  lane :production do
    ENV['BUILD_ENV'] = 'PROD'
    release
  end
end

# Android Platform
platform :android do
  desc "Build and upload Android app to Google Play"
  lane :release do |options|
    env_type = ENV['BUILD_ENV'] || 'PROD'
    
    # Environment-based track selection
    if env_type == 'PROD'
      track = options[:track] || 'production'
    else
      track = options[:track] || 'internal'
    end

    # Increment build number (handled externally on CI)
    build_number, version_string = next_build_info(env_type)

    # Build the app (no flavor needed)
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "flutter.versionCode" => build_number,
        "flutter.versionName" => version_string
      }
    )

    # Upload to Google Play
    upload_to_play_store(
      track: track,
      package_name: "org.usernode.app",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Commit version bump
    commit_version_bump(
      ["pubspec.yaml"],
      "Bump Android #{env_type} build to #{build_number}"
    )
  end

  desc "Build Android app for internal testing"
  lane :internal do
    ENV['BUILD_ENV'] = 'NONPROD'
    release(track: 'internal')
  end

  desc "Build Android app for production"
  lane :production do
    ENV['BUILD_ENV'] = 'PROD'
    release(track: 'production')
  end
end
