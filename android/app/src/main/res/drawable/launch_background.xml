<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window's drawable. Reads the theme's colorBackground rather
     than a literal, so values/ and values-night/ decide the colour — this
     file used to hardcode a framework white, which painted a white
     launch frame under a near-black shell on any device that reached it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <!-- Black on the light ground, cream on the dark one: the -night
         qualifier on the drawable picks the appearance, matching the
         LaunchImage.imageset appearances on iOS. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
