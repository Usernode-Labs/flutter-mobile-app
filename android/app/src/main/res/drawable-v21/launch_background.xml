<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to drawable/launch_background.xml since both read the theme.
     Kept as a separate qualifier because the manifest's windowBackground
     resolves per API level and removing it would change which file API 21+
     picks. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
    <!-- Black on the light ground, cream on the dark one: the -night
         qualifier on the drawable picks the appearance, matching the
         LaunchImage.imageset appearances on iOS. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
