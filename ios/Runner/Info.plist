<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Usernode</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mobile_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.1</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>16</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiresFullScreen</key>
	<true/>
    <key>NFCReaderUsageDescription</key>
    <string>NFC is used to read your ID document.</string>
    <key>NSCameraUsageDescription</key>
    <string>Camera is used to scan QR codes and documents.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Biometrics are used to unlock your private data.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Photo access lets you upload images to dapps you open in Usernode.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>FirebaseMessagingAutoInitEnabled</key>
    <false/>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>be.tramckrijte.workmanager.slot_monitoring_task</string>
        <string>com.usernode.app.slotmonitoring</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.usernode.zkpassport.callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>usernode-zk</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.usernode.app.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>usernode</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>zkpassport</string>
		<string>market</string>
	</array>
	<!-- App-Bound Domains: unlocks Service Workers (SV's offline PWA mode)
	     inside WKWebView for these registrable domains and their subdomains.
	     Webviews opting in via limitsNavigationsToAppBoundDomains can only
	     navigate to these domains; JS injection (the Usernode bridge channel)
	     is restricted to them app-wide once this key exists. External links
	     are opened via the openExternal bridge method instead. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>usernodelabs.org</string>
		<string>evanshapiro.dev</string>
		<string>localhost</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
