<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      flutter_secure_storage 9.x shares this file process-wide. Exclude the
      default file rather than selecting custom Android options, which can
      redirect unrelated secure-storage users in the same process.
    -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
