{
  "permissions": {
    "allow": [
      "Bash(dart format:*)",
      "Bash(dart fix:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter gen-l10n:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout . :*)",
      "Bash(git branch -D:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test \"${file_path##*.}\" = \"dart\" && dart format \"$file_path\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
