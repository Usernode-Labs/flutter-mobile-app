# Fastfile for Usernode CI/CD
# Uses pubspec.yaml as the single source of truth for version and build numbers

default_platform(:ios)

require 'yaml'

# Load version information from pubspec.yaml
def load_pubspec
  pubspec_file = File.join(Dir.pwd, '..', 'pubspec.yaml')
  YAML.load_file(pubspec_file)
end

def save_pubspec(pubspec_data)
  pubspec_file = File.join(Dir.pwd, '..', 'pubspec.yaml')
  File.write(pubspec_file, YAML.dump(pubspec_data))
end

def get_current_version
  pubspec = load_pubspec
  version_string = pubspec['version']

  if version_string.nil? || version_string.empty?
    UI.user_error!("No version found in pubspec.yaml")
  end

  # Split version string: "0.1.1+12"
  parts = version_string.split('+')
  semantic = parts[0]           # "0.1.1"
  build = parts[1] || "1"       # "12" or default "1"

  { semantic: semantic, build: build.to_i, full: version_string }
end

def get_version_string(flavor)
  version_info = get_current_version
  semantic = version_info[:semantic]
  build = version_info[:build]

  if flavor == 'production'
    semantic
  else
    # For backward compatibility with old format
    "#{semantic}.#{build}-#{flavor}"
  end
end

def increment_build_number(flavor)
  # Note: Flavor parameter accepted for backward compatibility but ignored
  # All flavors now share the same build number
  version_info = get_current_version
  new_build = version_info[:build] + 1
  new_version = "#{version_info[:semantic]}+#{new_build}"

  pubspec = load_pubspec
  pubspec['version'] = new_version
  save_pubspec(pubspec)

  UI.success("Incremented build number: #{version_info[:build]} -> #{new_build}")
  UI.success("New version: #{new_version}")

  new_build
end

# iOS Platform
platform :ios do
  desc "Build and upload iOS app to TestFlight"
  lane :release do |options|
    flavor = options[:flavor] || 'production'
    scheme = flavor.capitalize

    # Increment build number
    build_number = increment_build_number(flavor)
    version_string = get_version_string(flavor)

    # Update version in Xcode
    increment_build_number(
      build_number: build_number,
      xcodeproj: "ios/Runner.xcodeproj"
    )

    increment_version_number(
      version_number: version_string,
      xcodeproj: "ios/Runner.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: scheme,
      workspace: "ios/Runner.xcworkspace",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "org.usernode.app" => "Usernode #{scheme}"
        }
      },
      output_directory: "build/ios",
      output_name: "Usernode-#{flavor}-#{version_string}.ipa"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      apple_id: ENV['APPLE_ID'],
      app_identifier: "org.usernode.app",
      ipa: "build/ios/Usernode-#{flavor}-#{version_string}.ipa"
    )

    # Commit version bump
    git_commit(
      path: ["pubspec.yaml"],
      message: "Bump iOS #{flavor} build to #{build_number}"
    )
  end

  desc "Build iOS app for internal testing"
  lane :internal do
    release(flavor: 'internal')
  end

  desc "Build iOS app for alpha testing"
  lane :alpha do
    release(flavor: 'alpha')
  end

  desc "Build iOS app for beta testing"
  lane :beta do
    release(flavor: 'beta')
  end

  desc "Build iOS app for production"
  lane :production do
    release(flavor: 'production')
  end
end

# Android Platform
platform :android do
  desc "Build and upload Android app to Google Play"
  lane :release do |options|
    flavor = options[:flavor] || 'production'
    track = options[:track] || 'internal'

    # Increment build number
    build_number = increment_build_number(flavor)
    version_string = get_version_string(flavor)

    # Build the app
    gradle(
      task: "bundle",
      flavor: flavor,
      build_type: "Release",
      project_dir: "android",
      properties: {
        "flutter.versionCode" => build_number,
        "flutter.versionName" => version_string
      }
    )

    # Upload to Google Play
    upload_to_play_store(
      track: track,
      package_name: "org.usernode.app",
      aab: "build/app/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Commit version bump
    git_commit(
      path: ["pubspec.yaml"],
      message: "Bump Android #{flavor} build to #{build_number}"
    )
  end

  desc "Build Android app for internal testing"
  lane :internal do
    release(flavor: 'internal', track: 'internal')
  end

  desc "Build Android app for alpha testing"
  lane :alpha do
    release(flavor: 'alpha', track: 'alpha')
  end

  desc "Build Android app for beta testing"
  lane :beta do
    release(flavor: 'beta', track: 'beta')
  end

  desc "Build Android app for production"
  lane :production do
    release(flavor: 'production', track: 'production')
  end
end
